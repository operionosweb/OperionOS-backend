# Backend OCI configuration. Keep real values in the hosting provider or ignored local files.
OCI_ALLOWED_ORIGINS=https://oci.operionos.com
# Existing backend authentication/database configuration is also required:
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=
# Optional approved provider CA PEM with actual newlines. OCI always verifies TLS.
OCI_DATABASE_CA=
# Only for an operator-controlled initial provisioning session, never the frontend:
OCI_BOOTSTRAP_EMAIL=
OCI_BOOTSTRAP_ACCESS_TOKEN=
