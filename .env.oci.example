# Backend OCI configuration. Keep real values in the hosting provider or ignored local files.
OCI_ALLOWED_ORIGINS=https://oci.operionos.com
# OCI-only runtime authentication and PostgreSQL. Both destinations must use this project reference.
OCI_DATABASE_TARGET=dedicated-oci
OCI_SUPABASE_PROJECT_REF=
OCI_SUPABASE_URL=https://<project-ref>.supabase.co
OCI_SUPABASE_ANON_KEY=
OCI_DATABASE_URL=
# Optional approved provider CA PEM with actual newlines. OCI always verifies TLS.
OCI_DATABASE_CA=
# Explicit target checks for the operator-only migration/bootstrap commands:
OCI_MIGRATION_TARGET=dedicated-oci
OCI_MIGRATION_PROJECT_REF=
OCI_MIGRATION_DATABASE_URL=
OCI_BOOTSTRAP_TARGET=dedicated-oci
OCI_BOOTSTRAP_PROJECT_REF=
OCI_BOOTSTRAP_DATABASE_URL=
# Only for an operator-controlled bootstrap session, never the frontend:
OCI_BOOTSTRAP_ACCESS_TOKEN=
