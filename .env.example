PORT=10000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Main database connections require certificate-chain and hostname verification.
# A URL may omit SSL options or use sslmode=verify-full; other SSL URL options
# are rejected. DATABASE_CA is an optional PEM trust bundle, supplied securely.
DATABASE_URL=
DATABASE_CA=
DOCUMENT_STORAGE_BUCKET=contract-documents
CORS_ORIGIN=http://localhost:3000
# AI Gateway: Mistral is the default provider. Keep credentials server-side.
AI_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
# Optional routing/experimentation layer; leave unset for direct Mistral calls.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-large-latest
# Contact form delivery via https://resend.com
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Operion <noreply@operionos.com>
# Xweather Raster Maps: server-only credentials. Enable only after confirming
# subscription/display rights and the per-process tile request budget.
XWEATHER_MAPS_ENABLED=0
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=
