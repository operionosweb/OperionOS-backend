PORT=10000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DOCUMENT_STORAGE_BUCKET=contract-documents
CORS_ORIGIN=http://localhost:3000
# AI Gateway: Mistral is the default provider. Keep credentials server-side.
AI_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
# Optional routing/experimentation layer; leave unset for direct Mistral calls.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-large-latest
